# ESP32-S3 board (Sunton ESP32-8048S043 class): added to sdkconfig.defaults
# by scripts/cargo-esp.sh when BOARD=s3 (the default).

# ---- CPU and caches ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- 8 MB octal PSRAM ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Run code and constants from PSRAM so flash writes (NVS) do not stall the
# RGB panel, which streams from PSRAM continuously.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# ---- RGB LCD ----
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# ---- Console on UART0 (CH340). GPIO19/20 are the native USB pins, but this
# board uses them for the touch controller's I2C bus, so USB stays off. ----
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# UI on core 1; Wi-Fi and the LCD interrupt on core 0 (see main.rs).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y

