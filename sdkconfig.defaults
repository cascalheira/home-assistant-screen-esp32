# Settings shared by both boards. Chip-specific ones are in
# sdkconfig.defaults.esp32s3 and sdkconfig.defaults.esp32p4.

# ---- Flash and partitions (16 MB quad flash) ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# The custom partition table (partitions.csv) is switched on by
# scripts/cargo-esp.sh, which passes its absolute path. ESP-IDF builds in a
# nested output folder and would not find a relative path.

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Tasks ----
CONFIG_FREERTOS_HZ=1000
# Slint's layout and rendering code is stack hungry.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---- Wi-Fi ----
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_LWIP_LOCAL_HOSTNAME="esp32-screen"

# ---- Home Assistant connection ----
# Resolve "homeassistant.local" style names through mDNS.
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# ---- SD card ----
# Long file names (otherwise only 8.3 names like LICENC~1.BRO are visible).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ---- Firmware updates ----
# A new image boots "pending verify"; if it doesn't mark itself valid (it
# does after running for a while, see src/ota.rs) the bootloader returns to
# the previous image on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# TLS (HTTPS Home Assistant) buffers in PSRAM: internal RAM has about 30 KB
# free, less than one TLS session needs.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
