// Colours shared by every screen.

export global Theme {
    out property <color> bg: #0f1115;
    out property <color> surface: #1a1e26;
    out property <color> surface-2: #252a35;
    out property <color> surface-3: #343b4b;
    out property <color> line: #2a303c;
    out property <color> text: #eef1f6;
    out property <color> muted: #98a2b3;
    out property <color> accent: #3b82f6;
    out property <color> accent-pressed: #2563eb;
    out property <color> success: #22c55e;
    out property <color> danger: #ef4444;
    out property <color> warning: #f59e0b;
}
