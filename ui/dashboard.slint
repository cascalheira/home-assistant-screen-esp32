// Dashboard pieces: tiles on the grid and the climate / dimmer pop-ups.
//
// Icons come from Material Design Icons (the set Home Assistant uses). Only
// the glyphs written as string literals in the .slint files are embedded.

import "fonts/MaterialDesignIcons.ttf";
import { Theme } from "theme.slint";
import { TileData, ModeItem, ActionButton } from "types.slint";
import { Button } from "widgets.slint";

export global Icons {
    out property <string> family: "Material Design Icons";

    pure public function for-tile(kind: string, on: bool, mode: string, domain: string) -> string {
        if (kind == "light") {
            return on ? "\u{F0335}" : "\u{F0336}";
        }
        if (kind == "gate") {
            return on ? "\u{F116A}" : "\u{F0299}";
        }
        if (kind == "garage") {
            return on ? "\u{F06DA}" : "\u{F06D9}";
        }
        if (kind == "valve") {
            return on ? "\u{F1068}" : "\u{F1067}";
        }
        if (kind == "climate") {
            return Icons.for-mode(mode);
        }
        if (kind == "toggle") {
            if (domain == "automation") {
                return on ? "\u{F06A9}" : "\u{F16A7}";
            }
            return on ? "\u{F0521}" : "\u{F0A19}";
        }
        if (kind == "scene") {
            if (domain == "scene") {
                return "\u{F03D8}";
            }
            return on ? "\u{F040C}" : "\u{F040D}";
        }
        if (kind == "sensor") {
            if (domain == "binary_sensor") {
                return on ? "\u{F0208}" : "\u{F06D0}";
            }
            return "\u{F029A}";
        }
        if (kind == "blind") {
            return on ? "\u{F1011}" : "\u{F00AC}";
        }
        if (kind == "lock") {
            return on ? "\u{F0FC6}" : "\u{F033E}";
        }
        if (kind == "alarm") {
            if (mode == "triggered") {
                return "\u{F078F}";
            }
            return on ? "\u{F099D}" : "\u{F099C}";
        }
        if (kind == "media") {
            return on ? "\u{F040A}" : "\u{F04C3}";
        }
        return "\u{F05D6}";
    }

    // Icon for a button in the action sheet (ActionButton.id).
    pure public function for-action(id: string) -> string {
        if (id == "open") {
            return "\u{F0737}";
        }
        if (id == "close") {
            return "\u{F072E}";
        }
        if (id == "stop") {
            return "\u{F04DB}";
        }
        if (id == "lock") {
            return "\u{F033E}";
        }
        if (id == "unlock") {
            return "\u{F0FC6}";
        }
        if (id == "arm_home") {
            return "\u{F068A}";
        }
        if (id == "arm_away") {
            return "\u{F099D}";
        }
        if (id == "arm_night") {
            return "\u{F1828}";
        }
        if (id == "arm_vacation") {
            return "\u{F06BB}";
        }
        if (id == "disarm") {
            return "\u{F099C}";
        }
        if (id == "previous") {
            return "\u{F04AE}";
        }
        if (id == "play_pause") {
            return "\u{F040A}";
        }
        if (id == "pause") {
            return "\u{F03E4}";
        }
        if (id == "next") {
            return "\u{F04AD}";
        }
        if (id == "toggle") {
            return "\u{F0425}";
        }
        return "\u{F05E1}";
    }

    pure public function for-mode(mode: string) -> string {
        if (mode == "cool") {
            return "\u{F0717}";
        }
        if (mode == "heat") {
            return "\u{F0238}";
        }
        if (mode == "heat_cool") {
            return "\u{F1A79}";
        }
        if (mode == "auto") {
            return "\u{F006A}";
        }
        if (mode == "dry") {
            return "\u{F058E}";
        }
        if (mode == "fan_only") {
            return "\u{F0210}";
        }
        if (mode == "off") {
            return "\u{F0425}";
        }
        return "\u{F001B}";
    }

    // Accent colour of a tile.
    pure public function tint(kind: string, mode: string) -> color {
        if (kind == "light") {
            return #f5b83d;
        }
        if (kind == "valve") {
            return #22d3ee;
        }
        if (kind == "toggle") {
            return #4ade80;
        }
        if (kind == "scene") {
            return #c084fc;
        }
        if (kind == "sensor") {
            return #a3e635;
        }
        if (kind == "lock") {
            return #fb923c;
        }
        if (kind == "alarm") {
            return #f87171;
        }
        if (kind == "media") {
            return #34d399;
        }
        if (kind == "climate") {
            if (mode == "heat") {
                return #fb923c;
            }
            if (mode == "cool") {
                return #38bdf8;
            }
            return #a78bfa;
        }
        return #60a5fa;
    }
}

export component TileView inherits Rectangle {
    in property <TileData> tile;
    callback tapped();
    callback long-pressed();

    property <color> tint: Icons.tint(root.tile.kind, root.tile.mode);
    property <bool> long-fired: false;

    border-radius: 18px;
    background: !root.tile.available ? #15181e
        : ta.pressed ? (root.tile.on ? root.tint.with-alpha(0.34) : Theme.surface-3)
        : root.tile.on ? root.tint.with-alpha(0.22) : Theme.surface;
    border-width: root.tile.on && root.tile.available ? 2px : 0px;
    border-color: root.tint.with-alpha(0.55);

    VerticalLayout {
        padding: 14px;
        spacing: 2px;
        HorizontalLayout {
            Text {
                text: Icons.for-tile(root.tile.kind, root.tile.on, root.tile.mode, root.tile.domain);
                font-family: Icons.family;
                font-size: 40px;
                color: !root.tile.available ? Theme.muted : root.tile.on ? root.tint : Theme.text;
                vertical-alignment: top;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.tile.moving: Rectangle {
                width: 10px;
                height: 10px;
                y: 6px;
                border-radius: 5px;
                background: root.tint.with-alpha(0.4 + 0.6 * Math.abs(Math.sin(animation-tick() / 1s * 180deg)));
            }
        }
        Rectangle { vertical-stretch: 1; }
        // Only where there is room for it.
        if root.tile.value != "" && root.height >= 180px: Text {
            text: root.tile.value;
            font-size: 40px;
            font-weight: 600;
            overflow: elide;
            color: root.tile.on && root.tile.available ? root.tint : Theme.text;
        }
        Text {
            text: root.tile.label;
            font-size: 18px;
            font-weight: 600;
            color: root.tile.available ? Theme.text : Theme.muted;
            overflow: elide;
        }
        Text {
            text: root.tile.detail == "" ? root.tile.status : root.tile.status + " · " + root.tile.detail;
            font-size: 14px;
            color: root.tile.on && root.tile.available ? root.tint : Theme.muted;
            overflow: elide;
        }
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.long-fired = false;
            }
        }
        clicked => {
            if (!root.long-fired) {
                root.tapped();
            }
        }
    }
    Timer {
        interval: 600ms;
        running: ta.pressed && !root.long-fired;
        triggered => {
            root.long-fired = true;
            root.long-pressed();
        }
    }
}

component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked();
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background: !root.enabled ? Theme.surface : ta.pressed ? Theme.surface-3 : Theme.surface-2;
    Text {
        text: root.glyph;
        font-family: Icons.family;
        font-size: 40px;
        color: root.enabled ? Theme.text : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Sheet inherits Rectangle {
    in property <string> title;
    callback close();
    background: #000000b8;
    TouchArea {
        clicked => { root.close(); }
    }
    card := Rectangle {
        width: 620px;
        height: 400px;
        border-radius: 20px;
        background: Theme.surface;
        // Swallow taps on the card itself.
        TouchArea { }
        Text {
            x: 28px;
            y: 22px;
            width: parent.width - 120px;
            text: root.title;
            font-size: 24px;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
        Rectangle {
            x: parent.width - 76px;
            y: 12px;
            width: 60px;
            height: 60px;
            border-radius: 30px;
            background: close-ta.pressed ? Theme.surface-3 : transparent;
            Text {
                text: "\u{F0156}";
                font-family: Icons.family;
                font-size: 28px;
                color: Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            close-ta := TouchArea {
                clicked => { root.close(); }
            }
        }
        Rectangle {
            y: 80px;
            height: parent.height - 80px;
            @children
        }
    }
}

export component ClimateSheet inherits Sheet {
    in property <string> target; // formatted, e.g. "24.0"
    in property <string> unit;
    in property <string> current; // formatted, "" when unknown
    in property <string> humidity; // whole percent, "" when unknown
    in property <string> mode;
    in property <[ModeItem]> modes;
    in property <bool> can-down;
    in property <bool> can-up;
    in property <bool> available;
    callback step(int);
    callback set-mode(string);

    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 24px;
        spacing: 18px;
        HorizontalLayout {
            alignment: center;
            spacing: 36px;
            RoundButton {
                y: 14px;
                glyph: "\u{F0374}";
                enabled: root.available && root.can-down && root.mode != "off";
                clicked => { root.step(-1); }
            }
            VerticalLayout {
                alignment: center;
                width: 260px;
                Text {
                    text: root.mode == "off" ? "Off" : root.target == "" ? "–" : root.target + root.unit;
                    font-size: 48px;
                    font-weight: 600;
                    color: root.mode == "off" ? Theme.muted : Icons.tint("climate", root.mode);
                    horizontal-alignment: center;
                }
                Text {
                    text: (root.current == "" ? "" : "Now " + root.current + root.unit)
                        + (root.current != "" && root.humidity != "" ? " · " : "")
                        + (root.humidity == "" ? "" : root.humidity + "%");
                    font-size: 18px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
            }
            RoundButton {
                y: 14px;
                glyph: "\u{F0415}";
                enabled: root.available && root.can-up && root.mode != "off";
                clicked => { root.step(1); }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 10px;
            alignment: center;
            for m in root.modes: Rectangle {
                width: 80px;
                height: 80px;
                border-radius: 16px;
                background: m.id == root.mode ? Icons.tint("climate", m.id).with-alpha(0.25)
                    : mode-ta.pressed ? Theme.surface-3 : Theme.surface-2;
                border-width: m.id == root.mode ? 2px : 0px;
                border-color: Icons.tint("climate", m.id);
                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    Text {
                        text: Icons.for-mode(m.id);
                        font-family: Icons.family;
                        font-size: 28px;
                        color: m.id == root.mode ? Icons.tint("climate", m.id) : Theme.text;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: m.label;
                        font-size: 14px;
                        color: Theme.muted;
                        horizontal-alignment: center;
                    }
                }
                mode-ta := TouchArea {
                    enabled: root.available;
                    clicked => { root.set-mode(m.id); }
                }
            }
        }
    }
}

export component DimmerSheet inherits Sheet {
    in-out property <int> value; // 0-100
    in property <bool> is-on;
    callback commit(int);
    callback toggle();

    VerticalLayout {
        padding-left: 40px;
        padding-right: 40px;
        padding-bottom: 28px;
        spacing: 28px;
        Text {
            text: root.is-on ? root.value + "%" : "Off";
            font-size: 48px;
            font-weight: 600;
            color: root.is-on ? #f5b83d : Theme.muted;
            horizontal-alignment: center;
        }
        track := Rectangle {
            height: 72px;
            border-radius: 18px;
            background: Theme.surface-2;
            clip: true;
            Rectangle {
                x: 0px;
                width: parent.width * root.value / 100;
                border-radius: 18px;
                background: #f5b83d;
            }
            TouchArea {
                function set-from(px: length) {
                    root.value = Math.round(Math.clamp(px / track.width * 100, 1, 100));
                }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.set-from(self.mouse-x);
                    } else if (e.kind == PointerEventKind.up) {
                        // Commit on release, even if the finger slid off the track.
                        root.commit(root.value);
                    }
                }
                moved => { self.set-from(self.mouse-x); }
            }
        }
        HorizontalLayout {
            alignment: center;
            Button {
                text: root.is-on ? "Turn off" : "Turn on";
                clicked => { root.toggle(); }
            }
        }
    }
}

component SheetButton inherits Rectangle {
    in property <ActionButton> button;
    in property <string> kind;
    // Icon left of the label, for the column next to the keypad.
    in property <bool> compact;
    callback clicked();
    min-width: 96px;
    height: root.compact ? 44px : 76px;
    border-radius: 16px;
    background: ta.pressed ? Theme.surface-3
        : root.button.primary ? Icons.tint(root.kind, "").with-alpha(0.25) : Theme.surface-2;
    border-width: root.button.primary ? 2px : 0px;
    border-color: Icons.tint(root.kind, "");
    if !root.compact: VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 2px;
        Text {
            text: Icons.for-action(root.button.id);
            font-family: Icons.family;
            font-size: 28px;
            color: root.button.primary ? Icons.tint(root.kind, "") : Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.button.label;
            font-size: 14px;
            color: Theme.muted;
            horizontal-alignment: center;
        }
    }
    if root.compact: HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        Text {
            text: Icons.for-action(root.button.id);
            font-family: Icons.family;
            font-size: 24px;
            color: root.button.primary ? Icons.tint(root.kind, "") : Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: root.button.label;
            font-size: 16px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component KeypadKey inherits Rectangle {
    in property <string> label;
    in property <bool> icon;
    callback clicked();
    height: 48px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: ta.pressed ? Theme.surface-3 : Theme.surface-2;
    Text {
        text: root.label;
        font-family: root.icon ? Icons.family : "Inter";
        font-size: 24px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Pop-up for tiles with several actions: blinds, locks, alarm panels and
// media players. Rust fills it (src/app.rs, refresh_sheet).
export component ActionSheet inherits Sheet {
    in property <string> kind;
    in property <string> status;
    in property <[ActionButton]> buttons;
    in property <bool> show-slider;
    in property <string> slider-label;
    in-out property <int> slider-value; // 0-100
    in property <bool> show-keypad;
    in property <string> code; // masked
    callback action(string);
    callback slider-commit(int);
    callback key(string);
    callback backspace();

    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 22px;
        spacing: 14px;
        Text {
            text: root.status;
            font-size: 24px;
            font-weight: 600;
            color: Icons.tint(root.kind, "");
            overflow: elide;
        }
        if root.show-keypad: HorizontalLayout {
            spacing: 22px;
            vertical-stretch: 1;
            VerticalLayout {
                width: 270px;
                spacing: 6px;
                Rectangle {
                    height: 40px;
                    border-radius: 10px;
                    background: Theme.bg;
                    Text {
                        text: root.code == "" ? "Code" : root.code;
                        font-size: 20px;
                        color: root.code == "" ? Theme.muted : Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]: HorizontalLayout {
                    spacing: 6px;
                    for k in row: KeypadKey {
                        label: k;
                        clicked => { root.key(k); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    KeypadKey {
                        label: "0";
                        clicked => { root.key("0"); }
                    }
                    KeypadKey {
                        label: "\u{F0B5C}";
                        icon: true;
                        clicked => { root.backspace(); }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                for b in root.buttons: SheetButton {
                    compact: true;
                    button: b;
                    kind: root.kind;
                    clicked => { root.action(b.id); }
                }
            }
        }
        if !root.show-keypad && root.show-slider: VerticalLayout {
            spacing: 8px;
            Text {
                text: root.slider-label + " · " + root.slider-value + "%";
                font-size: 16px;
                color: Theme.muted;
            }
            track := Rectangle {
                height: 64px;
                border-radius: 16px;
                background: Theme.surface-2;
                clip: true;
                Rectangle {
                    x: 0px;
                    width: parent.width * root.slider-value / 100;
                    border-radius: 16px;
                    background: Icons.tint(root.kind, "");
                }
                TouchArea {
                    function set-from(px: length) {
                        root.slider-value = Math.round(Math.clamp(px / track.width * 100, 0, 100));
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            self.set-from(self.mouse-x);
                        } else if (e.kind == PointerEventKind.up) {
                            root.slider-commit(root.slider-value);
                        }
                    }
                    moved => { self.set-from(self.mouse-x); }
                }
            }
        }
        if !root.show-keypad: Rectangle { vertical-stretch: 1; }
        if !root.show-keypad: HorizontalLayout {
            spacing: 12px;
            alignment: center;
            for b in root.buttons: SheetButton {
                button: b;
                kind: root.kind;
                clicked => { root.action(b.id); }
            }
        }
    }
}
