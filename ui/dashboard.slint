// Dashboard pieces: tiles on the grid and the climate / dimmer pop-ups.
//
// Icons come from Material Design Icons (the set Home Assistant uses). Only
// the glyphs written as string literals in the .slint files are embedded.

import "fonts/MaterialDesignIcons.ttf";
import { Theme } from "theme.slint";
import { TileData, ModeItem, ActionButton } from "types.slint";
import { Button } from "widgets.slint";

export global Icons {
    out property <string> family: "Material Design Icons";

    pure public function for-tile(kind: string, on: bool, mode: string, domain: string) -> string {
        if (kind == "light") {
            return on ? "\u{F0335}" : "\u{F0336}";
        }
        if (kind == "gate") {
            return on ? "\u{F116A}" : "\u{F0299}";
        }
        if (kind == "garage") {
            return on ? "\u{F06DA}" : "\u{F06D9}";
        }
        if (kind == "valve") {
            return on ? "\u{F1068}" : "\u{F1067}";
        }
        if (kind == "climate") {
            return Icons.for-mode(mode);
        }
        if (kind == "toggle") {
            if (domain == "automation") {
                return on ? "\u{F06A9}" : "\u{F16A7}";
            }
            return on ? "\u{F0521}" : "\u{F0A19}";
        }
        if (kind == "scene") {
            if (domain == "scene") {
                return "\u{F03D8}";
            }
            return on ? "\u{F040C}" : "\u{F040D}";
        }
        if (kind == "sensor") {
            if (domain == "binary_sensor") {
                return on ? "\u{F0208}" : "\u{F06D0}";
            }
            return "\u{F029A}";
        }
        if (kind == "blind") {
            return on ? "\u{F1011}" : "\u{F00AC}";
        }
        if (kind == "lock") {
            return on ? "\u{F0FC6}" : "\u{F033E}";
        }
        if (kind == "alarm") {
            if (mode == "triggered") {
                return "\u{F078F}";
            }
            return on ? "\u{F099D}" : "\u{F099C}";
        }
        if (kind == "media") {
            return on ? "\u{F040A}" : "\u{F04C3}";
        }
        return "\u{F05D6}";
    }

    // Icon for a button in the action sheet (ActionButton.id).
    pure public function for-action(id: string) -> string {
        if (id == "open") {
            return "\u{F0737}";
        }
        if (id == "close") {
            return "\u{F072E}";
        }
        if (id == "stop") {
            return "\u{F04DB}";
        }
        if (id == "lock") {
            return "\u{F033E}";
        }
        if (id == "unlock") {
            return "\u{F0FC6}";
        }
        if (id == "arm_home") {
            return "\u{F068A}";
        }
        if (id == "arm_away") {
            return "\u{F099D}";
        }
        if (id == "arm_night") {
            return "\u{F1828}";
        }
        if (id == "arm_vacation") {
            return "\u{F06BB}";
        }
        if (id == "disarm") {
            return "\u{F099C}";
        }
        if (id == "previous") {
            return "\u{F04AE}";
        }
        if (id == "play_pause") {
            return "\u{F040A}";
        }
        if (id == "pause") {
            return "\u{F03E4}";
        }
        if (id == "next") {
            return "\u{F04AD}";
        }
        if (id == "toggle") {
            return "\u{F0425}";
        }
        return "\u{F05E1}";
    }

    pure public function for-mode(mode: string) -> string {
        if (mode == "cool") {
            return "\u{F0717}";
        }
        if (mode == "heat") {
            return "\u{F0238}";
        }
        if (mode == "heat_cool") {
            return "\u{F1A79}";
        }
        if (mode == "auto") {
            return "\u{F006A}";
        }
        if (mode == "dry") {
            return "\u{F058E}";
        }
        if (mode == "fan_only") {
            return "\u{F0210}";
        }
        if (mode == "off") {
            return "\u{F0425}";
        }
        return "\u{F001B}";
    }

    // Accent colour of a tile.
    pure public function tint(kind: string, mode: string) -> color {
        if (kind == "light") {
            return #f5b83d;
        }
        if (kind == "valve") {
            return #22d3ee;
        }
        if (kind == "toggle") {
            return #4ade80;
        }
        if (kind == "scene") {
            return #c084fc;
        }
        if (kind == "sensor") {
            return #a3e635;
        }
        if (kind == "lock") {
            return #fb923c;
        }
        if (kind == "alarm") {
            return #f87171;
        }
        if (kind == "media") {
            return #34d399;
        }
        if (kind == "climate") {
            if (mode == "heat") {
                return #fb923c;
            }
            if (mode == "cool") {
                return #38bdf8;
            }
            return #a78bfa;
        }
        return #60a5fa;
    }
}

// A light level on a rounded bar: brightness (filled from the left), hue or
// colour temperature (gradient with a knob). Reports the value on release.
// It shows its own value while the finger is down and for a moment after,
// until Home Assistant's state catches up.
export component LevelSlider inherits Rectangle {
    in property <int> value; // from Home Assistant
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <string> style: "brightness"; // brightness | hue | kelvin
    in property <color> fill: #f5b83d;
    in property <bool> enabled: true;
    // The value shown, and whether it is the finger's rather than HA's.
    out property <int> shown: ta.pressed || root.holding ? root.local : root.value;
    out property <bool> active: ta.pressed || root.holding;
    callback changed(int);
    callback committed(int);
    callback settled();

    property <int> local;
    property <bool> holding: false;
    property <float> frac: Math.clamp((root.shown - root.minimum) / Math.max(1, root.maximum - root.minimum), 0, 1);

    border-radius: self.height / 2;
    background: Theme.surface-2;

    // The software renderer can't round a gradient: square gradient between
    // two round caps in its end colours.
    if root.style == "hue": Rectangle {
        Rectangle {
            x: 0px;
            width: root.height;
            border-radius: root.height / 2;
            background: #ff0000;
        }
        Rectangle {
            x: root.width - root.height;
            width: root.height;
            border-radius: root.height / 2;
            background: #ff0000;
        }
        Rectangle {
            x: root.height / 2;
            width: root.width - root.height;
            background: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);
        }
    }
    if root.style == "kelvin": Rectangle {
        Rectangle {
            x: 0px;
            width: root.height;
            border-radius: root.height / 2;
            background: #ff9d42;
        }
        Rectangle {
            x: root.width - root.height;
            width: root.height;
            border-radius: root.height / 2;
            background: #dbe7ff;
        }
        Rectangle {
            x: root.height / 2;
            width: root.width - root.height;
            background: @linear-gradient(90deg, #ff9d42 0%, #ffd2a1 40%, #fff4e8 65%, #dbe7ff 100%);
        }
    }
    if root.style == "brightness" && root.shown >= root.minimum: Rectangle {
        x: 0px;
        width: Math.max(root.height, root.width * root.frac);
        border-radius: root.height / 2;
        background: root.fill;
    }
    if root.style != "brightness": Rectangle {
        x: (root.width - root.height) * root.frac;
        width: root.height;
        border-radius: root.height / 2;
        border-width: 3px;
        border-color: #ffffff;
    }

    // A little taller than the bar: easier to hit with a finger.
    ta := TouchArea {
        y: -6px;
        height: root.height + 12px;
        enabled: root.enabled;
        function set-from(px: length) {
            root.local = Math.round(root.minimum + Math.clamp(px / root.width, 0, 1) * (root.maximum - root.minimum));
            root.changed(root.local);
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.set-from(self.mouse-x);
            } else if (e.kind == PointerEventKind.up) {
                // Commit on release, even if the finger slid off the bar.
                root.holding = true;
                root.committed(root.local);
            }
        }
        moved => { self.set-from(self.mouse-x); }
    }
    Timer {
        interval: 2500ms;
        running: root.holding && !ta.pressed;
        triggered => {
            root.holding = false;
            root.settled();
        }
    }
}

export component TileView inherits Rectangle {
    in property <TileData> tile;
    callback tapped();
    callback long-pressed();
    // A slider on the tile was released: "brightness" | "hue" | "kelvin".
    callback adjust(string, int);

    // The light's own colour while it is on, else the kind's.
    property <color> tint: root.tile.has-color ? root.tile.color : Icons.tint(root.tile.kind, root.tile.mode);
    // Text and icons in the tile's colour: darker on the light theme, where
    // the bright colours would hardly show on the pale tile.
    property <color> ink: Theme.dark ? root.tint : root.tint.darker(0.5);
    property <bool> controls: root.tile.ctl-brightness || root.tile.ctl-hue || root.tile.ctl-kelvin;
    // Three sliders only fit on tall tiles; colour temperature gives way.
    property <bool> show-kelvin: root.tile.ctl-kelvin && (root.height >= 150px || !(root.tile.ctl-brightness && root.tile.ctl-hue));
    property <string> glyph: root.tile.icon != "" ? root.tile.icon
        : Icons.for-tile(root.tile.kind, root.tile.on, root.tile.mode, root.tile.domain);
    property <bool> long-fired: false;

    border-radius: 18px;
    background: !root.tile.available ? Theme.unavailable
        : ta.pressed ? (root.tile.on ? root.tint.with-alpha(0.34) : Theme.surface-3)
        : root.tile.on ? root.tint.with-alpha(0.22) : Theme.surface;
    border-width: root.tile.on && root.tile.available ? 2px : 0px;
    border-color: root.tint.with-alpha(0.55);

    property <bool> climate: root.tile.kind == "climate" && root.tile.available;
    // The big number: the room's temperature, else the target.
    property <string> climate-big: root.tile.current != "" ? root.tile.current : root.tile.target;
    property <bool> climate-roomy: root.height >= 180px && root.width >= 300px;

    // Climate: mode icon and name on top; the room temperature big with the
    // target beside it; the mode and the humidity below.
    if root.climate: VerticalLayout {
        padding: 14px;
        padding-top: 12px;
        spacing: 0px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.glyph;
                font-family: Icons.family;
                font-size: 26px;
                color: root.tile.on ? root.ink : Theme.muted;
                vertical-alignment: center;
            }
            Text {
                text: root.tile.label;
                font-size: 17px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        Rectangle { vertical-stretch: 1; }
        // Bigger where there is room (two conditional texts: a ternary
        // between two font sizes trips the Xtensa compiler).
        HorizontalLayout {
            spacing: 10px;
            if !root.climate-roomy: Text {
                text: root.climate-big;
                font-size: 38px;
                font-weight: 600;
                color: Theme.text;
            }
            if root.climate-roomy: Text {
                text: root.climate-big;
                font-size: 48px;
                font-weight: 600;
                color: Theme.text;
            }
            // The target beside it; not when off, where it doesn't matter.
            if root.tile.mode != "off" && root.tile.current != "" && root.tile.target != "": Text {
                text: "→ " + root.tile.target;
                font-size: 17px;
                color: Theme.muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.tile.status;
                font-size: 15px;
                font-weight: 600;
                color: root.tile.on ? root.ink : Theme.muted;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.tile.humidity != "": HorizontalLayout {
                spacing: 2px;
                Text {
                    text: "\u{F058C}";
                    font-family: Icons.family;
                    font-size: 15px;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
                Text {
                    text: root.tile.humidity;
                    font-size: 15px;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }
        }
    }

    if !root.controls && !root.climate: VerticalLayout {
        padding: 14px;
        spacing: 2px;
        HorizontalLayout {
            Text {
                text: root.glyph;
                font-family: Icons.family;
                font-size: 40px;
                color: !root.tile.available ? Theme.muted : root.tile.on ? root.ink : Theme.text;
                vertical-alignment: top;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.tile.moving: Rectangle {
                width: 10px;
                height: 10px;
                y: 6px;
                border-radius: 5px;
                background: root.tint.with-alpha(0.4 + 0.6 * Math.abs(Math.sin(animation-tick() / 1s * 180deg)));
            }
        }
        Rectangle { vertical-stretch: 1; }
        // Only where there is room for it.
        if root.tile.value != "" && root.height >= 180px: Text {
            text: root.tile.value;
            font-size: 40px;
            font-weight: 600;
            overflow: elide;
            color: root.tile.on && root.tile.available ? root.ink : Theme.text;
        }
        Text {
            text: root.tile.label;
            font-size: 18px;
            font-weight: 600;
            color: root.tile.available ? Theme.text : Theme.muted;
            overflow: elide;
        }
        Text {
            text: root.tile.detail == "" ? root.tile.status : root.tile.status + " · " + root.tile.detail;
            font-size: 14px;
            color: root.tile.on && root.tile.available ? root.ink : Theme.muted;
            overflow: elide;
        }
    }

    // With sliders: icon and names on top, sliders (above the touch area,
    // so they get their own touches) at the bottom.
    if root.controls: VerticalLayout {
        padding: 12px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            Text {
                text: root.glyph;
                font-family: Icons.family;
                font-size: 30px;
                color: !root.tile.available ? Theme.muted : root.tile.on ? root.ink : Theme.text;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.tile.label;
                    font-size: 17px;
                    font-weight: 600;
                    color: root.tile.available ? Theme.text : Theme.muted;
                    overflow: elide;
                }
                Text {
                    text: root.tile.detail == "" ? root.tile.status : root.tile.status + " · " + root.tile.detail;
                    font-size: 13px;
                    color: root.tile.on && root.tile.available ? root.ink : Theme.muted;
                    overflow: elide;
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }

    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.long-fired = false;
            }
        }
        clicked => {
            if (!root.long-fired) {
                root.tapped();
            }
        }
    }
    if root.controls: VerticalLayout {
        padding: 12px;
        padding-top: 56px;
        spacing: 8px;
        alignment: end;
        if root.tile.ctl-brightness: LevelSlider {
            min-height: 16px;
            preferred-height: 30px;
            enabled: root.tile.available;
            minimum: 1;
            value: root.tile.on ? root.tile.brightness : 0;
            fill: root.tint;
            committed(v) => { root.adjust("brightness", v); }
        }
        if root.tile.ctl-hue: LevelSlider {
            min-height: 16px;
            preferred-height: 30px;
            enabled: root.tile.available;
            style: "hue";
            maximum: 359;
            value: root.tile.hue;
            committed(v) => { root.adjust("hue", v); }
        }
        if root.show-kelvin: LevelSlider {
            min-height: 16px;
            preferred-height: 30px;
            enabled: root.tile.available;
            style: "kelvin";
            minimum: root.tile.kelvin-min;
            maximum: root.tile.kelvin-max;
            value: root.tile.kelvin;
            committed(v) => { root.adjust("kelvin", v); }
        }
    }

    Timer {
        interval: 600ms;
        running: ta.pressed && !root.long-fired;
        triggered => {
            root.long-fired = true;
            root.long-pressed();
        }
    }
}

component RoundButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked();
    width: 84px;
    height: 84px;
    border-radius: 42px;
    background: !root.enabled ? Theme.surface : ta.pressed ? Theme.surface-3 : Theme.surface-2;
    Text {
        text: root.glyph;
        font-family: Icons.family;
        font-size: 40px;
        color: root.enabled ? Theme.text : Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Sheet inherits Rectangle {
    in property <string> title;
    callback close();
    background: #000000b8;
    TouchArea {
        clicked => { root.close(); }
    }
    card := Rectangle {
        width: 620px;
        height: 400px;
        border-radius: 20px;
        background: Theme.surface;
        // Swallow taps on the card itself.
        TouchArea { }
        Text {
            x: 28px;
            y: 22px;
            width: parent.width - 120px;
            text: root.title;
            font-size: 24px;
            font-weight: 600;
            color: Theme.text;
            overflow: elide;
        }
        Rectangle {
            x: parent.width - 76px;
            y: 12px;
            width: 60px;
            height: 60px;
            border-radius: 30px;
            background: close-ta.pressed ? Theme.surface-3 : transparent;
            Text {
                text: "\u{F0156}";
                font-family: Icons.family;
                font-size: 28px;
                color: Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            close-ta := TouchArea {
                clicked => { root.close(); }
            }
        }
        Rectangle {
            y: 80px;
            height: parent.height - 80px;
            @children
        }
    }
}

export component ClimateSheet inherits Sheet {
    in property <string> target; // formatted, e.g. "24.0"
    in property <string> unit;
    in property <string> current; // formatted, "" when unknown
    in property <string> humidity; // whole percent, "" when unknown
    in property <string> mode;
    in property <[ModeItem]> modes;
    in property <bool> can-down;
    in property <bool> can-up;
    in property <bool> available;
    callback step(int);
    callback set-mode(string);

    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 24px;
        spacing: 18px;
        HorizontalLayout {
            alignment: center;
            spacing: 36px;
            RoundButton {
                y: 14px;
                glyph: "\u{F0374}";
                enabled: root.available && root.can-down && root.mode != "off";
                clicked => { root.step(-1); }
            }
            VerticalLayout {
                alignment: center;
                width: 260px;
                Text {
                    text: root.mode == "off" ? "Off" : root.target == "" ? "–" : root.target + root.unit;
                    font-size: 48px;
                    font-weight: 600;
                    color: root.mode == "off" ? Theme.muted : Icons.tint("climate", root.mode);
                    horizontal-alignment: center;
                }
                Text {
                    text: (root.current == "" ? "" : "Now " + root.current + root.unit)
                        + (root.current != "" && root.humidity != "" ? " · " : "")
                        + (root.humidity == "" ? "" : root.humidity + "%");
                    font-size: 18px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
            }
            RoundButton {
                y: 14px;
                glyph: "\u{F0415}";
                enabled: root.available && root.can-up && root.mode != "off";
                clicked => { root.step(1); }
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 10px;
            alignment: center;
            for m in root.modes: Rectangle {
                width: 80px;
                height: 80px;
                border-radius: 16px;
                background: m.id == root.mode ? Icons.tint("climate", m.id).with-alpha(0.25)
                    : mode-ta.pressed ? Theme.surface-3 : Theme.surface-2;
                border-width: m.id == root.mode ? 2px : 0px;
                border-color: Icons.tint("climate", m.id);
                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 8px;
                    spacing: 4px;
                    Text {
                        text: Icons.for-mode(m.id);
                        font-family: Icons.family;
                        font-size: 28px;
                        color: m.id == root.mode ? Icons.tint("climate", m.id) : Theme.text;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: m.label;
                        font-size: 14px;
                        color: Theme.muted;
                        horizontal-alignment: center;
                    }
                }
                mode-ta := TouchArea {
                    enabled: root.available;
                    clicked => { root.set-mode(m.id); }
                }
            }
        }
    }
}

export component DimmerSheet inherits Sheet {
    in property <int> value; // brightness 0-100; -1 when not dimmable
    in property <bool> is-on;
    in property <int> hue: -1; // -1 when the light takes no colour
    in property <int> kelvin;
    in property <int> kelvin-min: -1; // -1 when it has no colour temperature
    in property <int> kelvin-max;
    in property <color> tint: #f5b83d;
    callback commit(int);
    callback hue-commit(int);
    callback kelvin-commit(int);
    callback toggle();

    // The brightness under the finger, while it moves.
    property <int> live;
    property <bool> live-active: false;

    VerticalLayout {
        padding-left: 40px;
        padding-right: 40px;
        padding-bottom: 28px;
        spacing: 18px;
        HorizontalLayout {
            spacing: 20px;
            Text {
                text: root.live-active ? root.live + "%"
                    : !root.is-on ? "Off" : root.value >= 0 ? root.value + "%" : "On";
                font-size: 44px;
                font-weight: 600;
                color: root.is-on || root.live-active ? (Theme.dark ? root.tint : root.tint.darker(0.5)) : Theme.muted;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Button {
                    text: root.is-on ? "Turn off" : "Turn on";
                    clicked => { root.toggle(); }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        if root.value >= 0: LevelSlider {
            height: 64px;
            minimum: 1;
            value: root.is-on ? root.value : 0;
            fill: root.tint;
            changed(v) => {
                root.live = v;
                root.live-active = true;
            }
            committed(v) => { root.commit(v); }
            settled => { root.live-active = false; }
        }
        if root.hue >= 0: LevelSlider {
            height: 52px;
            style: "hue";
            maximum: 359;
            value: root.hue;
            committed(v) => { root.hue-commit(v); }
        }
        if root.kelvin-min > 0: LevelSlider {
            height: 52px;
            style: "kelvin";
            minimum: root.kelvin-min;
            maximum: root.kelvin-max;
            value: root.kelvin;
            committed(v) => { root.kelvin-commit(v); }
        }
    }
}

component SheetButton inherits Rectangle {
    in property <ActionButton> button;
    in property <string> kind;
    // Icon left of the label, for the column next to the keypad.
    in property <bool> compact;
    callback clicked();
    min-width: 96px;
    height: root.compact ? 44px : 76px;
    border-radius: 16px;
    background: ta.pressed ? Theme.surface-3
        : root.button.primary ? Icons.tint(root.kind, "").with-alpha(0.25) : Theme.surface-2;
    border-width: root.button.primary ? 2px : 0px;
    border-color: Icons.tint(root.kind, "");
    if !root.compact: VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 2px;
        Text {
            text: Icons.for-action(root.button.id);
            font-family: Icons.family;
            font-size: 28px;
            color: root.button.primary ? Icons.tint(root.kind, "") : Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: root.button.label;
            font-size: 14px;
            color: Theme.muted;
            horizontal-alignment: center;
        }
    }
    if root.compact: HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        Text {
            text: Icons.for-action(root.button.id);
            font-family: Icons.family;
            font-size: 24px;
            color: root.button.primary ? Icons.tint(root.kind, "") : Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: root.button.label;
            font-size: 16px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component KeypadKey inherits Rectangle {
    in property <string> label;
    in property <bool> icon;
    callback clicked();
    height: 48px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: ta.pressed ? Theme.surface-3 : Theme.surface-2;
    Text {
        text: root.label;
        font-family: root.icon ? Icons.family : "Inter";
        font-size: 24px;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Pop-up for tiles with several actions: blinds, locks, alarm panels and
// media players. Rust fills it (src/app.rs, refresh_sheet).
export component ActionSheet inherits Sheet {
    in property <string> kind;
    in property <string> status;
    in property <[ActionButton]> buttons;
    in property <bool> show-slider;
    in property <string> slider-label;
    in-out property <int> slider-value; // 0-100
    in property <bool> show-keypad;
    in property <string> code; // masked
    callback action(string);
    callback slider-commit(int);
    callback key(string);
    callback backspace();

    VerticalLayout {
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 22px;
        spacing: 14px;
        Text {
            text: root.status;
            font-size: 24px;
            font-weight: 600;
            color: Icons.tint(root.kind, "");
            overflow: elide;
        }
        if root.show-keypad: HorizontalLayout {
            spacing: 22px;
            vertical-stretch: 1;
            VerticalLayout {
                width: 270px;
                spacing: 6px;
                Rectangle {
                    height: 40px;
                    border-radius: 10px;
                    background: Theme.bg;
                    Text {
                        text: root.code == "" ? "Code" : root.code;
                        font-size: 20px;
                        color: root.code == "" ? Theme.muted : Theme.text;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                for row in [["1", "2", "3"], ["4", "5", "6"], ["7", "8", "9"]]: HorizontalLayout {
                    spacing: 6px;
                    for k in row: KeypadKey {
                        label: k;
                        clicked => { root.key(k); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    KeypadKey {
                        label: "0";
                        clicked => { root.key("0"); }
                    }
                    KeypadKey {
                        label: "\u{F0B5C}";
                        icon: true;
                        clicked => { root.backspace(); }
                    }
                }
            }
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                for b in root.buttons: SheetButton {
                    compact: true;
                    button: b;
                    kind: root.kind;
                    clicked => { root.action(b.id); }
                }
            }
        }
        if !root.show-keypad && root.show-slider: VerticalLayout {
            spacing: 8px;
            Text {
                text: root.slider-label + " · " + root.slider-value + "%";
                font-size: 16px;
                color: Theme.muted;
            }
            track := Rectangle {
                height: 64px;
                border-radius: 16px;
                background: Theme.surface-2;
                clip: true;
                Rectangle {
                    x: 0px;
                    width: parent.width * root.slider-value / 100;
                    border-radius: 16px;
                    background: Icons.tint(root.kind, "");
                }
                TouchArea {
                    function set-from(px: length) {
                        root.slider-value = Math.round(Math.clamp(px / track.width * 100, 0, 100));
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            self.set-from(self.mouse-x);
                        } else if (e.kind == PointerEventKind.up) {
                            root.slider-commit(root.slider-value);
                        }
                    }
                    moved => { self.set-from(self.mouse-x); }
                }
            }
        }
        if !root.show-keypad: Rectangle { vertical-stretch: 1; }
        if !root.show-keypad: HorizontalLayout {
            spacing: 12px;
            alignment: center;
            for b in root.buttons: SheetButton {
                button: b;
                kind: root.kind;
                clicked => { root.action(b.id); }
            }
        }
    }
}
