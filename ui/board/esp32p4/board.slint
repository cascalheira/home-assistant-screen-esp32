// Art made for this board's pixel size (scripts/gen_clock_digits.py,
// scripts/gen_weather_icons.py).
// Imported as "@board"; build.rs points it at the folder for the chip.
// UI scale 1.25: 148x167.2 UI px = 185x209 panel px, drawn 1:1.

export global BoardArt {
    out property <[image]> digits: [
        @image-url("clock/0.png"),
        @image-url("clock/1.png"),
        @image-url("clock/2.png"),
        @image-url("clock/3.png"),
        @image-url("clock/4.png"),
        @image-url("clock/5.png"),
        @image-url("clock/6.png"),
        @image-url("clock/7.png"),
        @image-url("clock/8.png"),
        @image-url("clock/9.png"),
    ];
    // Size of the digit images in UI pixels.
    out property <length> digit-w: 148px;
    out property <length> digit-h: 167.2px;

    // Colour weather icon (Meteocons, ui/weather-svg) for HA's condition.
    pure public function weather-small(condition: string) -> image {
        if (condition == "sunny") {
            return @image-url("weather/clear-day-small.png");
        }
        if (condition == "clear-night") {
            return @image-url("weather/clear-night-small.png");
        }
        if (condition == "partlycloudy") {
            return @image-url("weather/partly-cloudy-day-small.png");
        }
        if (condition == "cloudy") {
            return @image-url("weather/cloudy-small.png");
        }
        if (condition == "rainy") {
            return @image-url("weather/rain-small.png");
        }
        if (condition == "pouring") {
            return @image-url("weather/extreme-rain-small.png");
        }
        if (condition == "lightning") {
            return @image-url("weather/thunderstorms-small.png");
        }
        if (condition == "lightning-rainy") {
            return @image-url("weather/thunderstorms-rain-small.png");
        }
        if (condition == "snowy") {
            return @image-url("weather/snow-small.png");
        }
        if (condition == "snowy-rainy") {
            return @image-url("weather/sleet-small.png");
        }
        if (condition == "hail") {
            return @image-url("weather/hail-small.png");
        }
        if (condition == "fog") {
            return @image-url("weather/fog-small.png");
        }
        if (condition == "windy") {
            return @image-url("weather/wind-small.png");
        }
        if (condition == "windy-variant") {
            return @image-url("weather/wind-small.png");
        }
        return @image-url("weather/not-available-small.png");
    }

    // Colour weather icon (Meteocons, ui/weather-svg) for HA's condition.
    pure public function weather-large(condition: string) -> image {
        if (condition == "sunny") {
            return @image-url("weather/clear-day-large.png");
        }
        if (condition == "clear-night") {
            return @image-url("weather/clear-night-large.png");
        }
        if (condition == "partlycloudy") {
            return @image-url("weather/partly-cloudy-day-large.png");
        }
        if (condition == "cloudy") {
            return @image-url("weather/cloudy-large.png");
        }
        if (condition == "rainy") {
            return @image-url("weather/rain-large.png");
        }
        if (condition == "pouring") {
            return @image-url("weather/extreme-rain-large.png");
        }
        if (condition == "lightning") {
            return @image-url("weather/thunderstorms-large.png");
        }
        if (condition == "lightning-rainy") {
            return @image-url("weather/thunderstorms-rain-large.png");
        }
        if (condition == "snowy") {
            return @image-url("weather/snow-large.png");
        }
        if (condition == "snowy-rainy") {
            return @image-url("weather/sleet-large.png");
        }
        if (condition == "hail") {
            return @image-url("weather/hail-large.png");
        }
        if (condition == "fog") {
            return @image-url("weather/fog-large.png");
        }
        if (condition == "windy") {
            return @image-url("weather/wind-large.png");
        }
        if (condition == "windy-variant") {
            return @image-url("weather/wind-large.png");
        }
        return @image-url("weather/not-available-large.png");
    }
}
