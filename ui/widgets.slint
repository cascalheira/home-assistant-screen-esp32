// Reusable widgets: buttons, icons, list rows, keyboard and text field.

import { Theme } from "theme.slint";
import { NetworkItem } from "types.slint";


export component Button inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    in property <bool> enabled: true;
    in property <length> min-button-width: 150px;
    callback clicked();

    min-height: 52px;
    // Never narrower than the label.
    min-width: max(root.min-button-width, label.preferred-width + 48px);
    border-radius: 12px;
    background: !root.enabled ? Theme.surface-2
        : root.primary ? (ta.pressed ? Theme.accent-pressed : Theme.accent)
        : root.destructive ? (ta.pressed ? #b91c1c : #dc2626)
        : (ta.pressed ? Theme.surface-3 : Theme.surface-2);

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        label := Text {
            text: root.text;
            font-size: 18px;
            font-weight: 600;
            // White on the coloured buttons, in either theme.
            color: !root.enabled ? Theme.muted : root.primary || root.destructive ? #ffffff : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component SignalBars inherits Rectangle {
    in property <int> bars; // 0-4
    in property <color> on-color: Theme.text;
    width: 22px;
    height: 18px;
    for i in 4: Rectangle {
        x: i * 6px;
        y: parent.height - self.height;
        width: 4px;
        height: 6px + i * 4px;
        border-radius: 1px;
        background: i < root.bars ? root.on-color : Theme.text.with-alpha(0.16);
    }
}

export component LockIcon inherits Rectangle {
    in property <color> tint: Theme.muted;
    width: 14px;
    height: 18px;
    Rectangle {
        x: 2px;
        y: 0px;
        width: 10px;
        height: 13px;
        border-radius: 5px;
        border-width: 2px;
        border-color: root.tint;
    }
    Rectangle {
        x: 0px;
        y: 7px;
        width: 14px;
        height: 11px;
        border-radius: 2px;
        background: root.tint;
    }
}

export component LoadingDots inherits Rectangle {
    in property <color> tint: Theme.accent;
    width: 64px;
    height: 16px;
    for i in 3: Rectangle {
        x: i * 24px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.tint.with-alpha(
            0.25 + 0.75 * Math.max(0, Math.sin(animation-tick() / 1s * 360deg - i * 70deg)));
    }
}

// A round badge with a single glyph in it (check mark, warning sign, ...).
export component Badge inherits Rectangle {
    in property <string> glyph;
    in property <color> tint;
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background: root.tint.with-alpha(0.15);
    Rectangle {
        width: 72px;
        height: 72px;
        border-radius: 36px;
        background: root.tint;
        Text {
            text: root.glyph;
            font-size: 40px;
            font-weight: 600;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component StepChip inherits Rectangle {
    in property <string> number;
    in property <string> label;
    in property <bool> active;
    in property <bool> done;
    height: 40px;
    border-radius: 20px;
    background: root.active ? Theme.accent.with-alpha(0.18) : Theme.surface;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 16px;
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 28px;
            height: 28px;
            y: 6px;
            border-radius: 14px;
            background: root.done ? Theme.success : root.active ? Theme.accent : Theme.surface-3;
            Text {
                text: root.done ? "✓" : root.number;
                font-size: 16px;
                font-weight: 600;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            font-size: 16px;
            color: root.active || root.done ? Theme.text : Theme.muted;
            vertical-alignment: center;
        }
    }
}

// Top bar of the wizard pages: back arrow, title and the step indicator.
export component Header inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "Step 1 of 2 · Wi-Fi";
    in property <bool> show-back: true;
    callback back();
    height: 76px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 20px;
        spacing: 8px;
        if root.show-back: Rectangle {
            width: 60px;
            border-radius: 12px;
            background: back-ta.pressed ? Theme.surface-2 : transparent;
            Text {
                text: "←";
                font-size: 28px;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            back-ta := TouchArea {
                clicked => { root.back(); }
            }
        }
        if !root.show-back: Rectangle { width: 16px; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 24px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: root.subtitle;
                font-size: 14px;
                color: Theme.muted;
            }
        }
        @children
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

export component NetworkRow inherits Rectangle {
    in property <NetworkItem> item;
    callback clicked();
    height: 64px;
    background: ta.pressed ? Theme.surface-2 : transparent;
    HorizontalLayout {
        padding-left: 28px;
        padding-right: 28px;
        spacing: 20px;
        SignalBars {
            y: (parent.height - self.height) / 2;
            bars: root.item.bars;
            visible: root.item.bars > 0;
        }
        Text {
            text: root.item.ssid;
            font-size: 20px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.item.secure: LockIcon {
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: "›";
            font-size: 28px;
            color: Theme.muted;
            vertical-alignment: center;
        }
    }
    Rectangle {
        x: 28px;
        y: parent.height - 1px;
        width: parent.width - 56px;
        height: 1px;
        background: Theme.line;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component Key inherits Rectangle {
    in property <string> label;
    in property <string> value: self.label;
    in property <bool> special;
    in property <bool> active;
    in property <bool> enabled: true;
    callback activated(string);

    horizontal-stretch: 1;
    border-radius: 8px;
    background: !root.enabled ? Theme.key-disabled
        : root.active ? (ta.pressed ? Theme.accent-pressed : Theme.accent)
        : ta.pressed ? Theme.key-pressed
        : root.special ? Theme.key-special : Theme.key;
    Text {
        text: root.label;
        font-size: 20px;
        color: !root.enabled ? Theme.muted : root.active ? #ffffff : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(root.value); }
    }
}

// On-screen keyboard. Letter, digit and symbol keys emit `key(text)`.
export component Keyboard inherits Rectangle {
    in property <string> enter-label: "Connect";
    in property <bool> enter-enabled: true;
    callback key(string);
    callback backspace();
    callback enter();

    property <bool> shift: false;
    property <bool> symbols: false;
    property <[string]> digits: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"];
    property <[string]> letters-1: ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"];
    property <[string]> letters-2: ["a", "s", "d", "f", "g", "h", "j", "k", "l"];
    property <[string]> letters-3: ["z", "x", "c", "v", "b", "n", "m"];
    property <[string]> symbols-1: ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")"];
    property <[string]> symbols-2: ["-", "_", "=", "+", "[", "]", "{", "}", "\\", "|"];
    property <[string]> symbols-3: ["`", "~", ";", ":", "'", "\"", "<", ">", "/", "?"];

    function emit(k: string) {
        root.key(root.shift && !root.symbols ? k.to-uppercase() : k);
        root.shift = false;
    }

    height: 292px;
    background: Theme.keyboard;

    VerticalLayout {
        padding: 8px;
        spacing: 7px;
        HorizontalLayout {
            spacing: 6px;
            for k in root.digits: Key {
                label: k;
                activated(v) => { root.emit(v); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            for k in (root.symbols ? root.symbols-1 : root.letters-1): Key {
                label: root.shift && !root.symbols ? k.to-uppercase() : k;
                value: k;
                activated(v) => { root.emit(v); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            padding-left: root.symbols ? 0px : 39px;
            padding-right: root.symbols ? 0px : 39px;
            for k in (root.symbols ? root.symbols-2 : root.letters-2): Key {
                label: root.shift && !root.symbols ? k.to-uppercase() : k;
                value: k;
                activated(v) => { root.emit(v); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            if !root.symbols: Key {
                label: "⇧";
                special: true;
                active: root.shift;
                horizontal-stretch: 1.5;
                activated => { root.shift = !root.shift; }
            }
            for k in (root.symbols ? root.symbols-3 : root.letters-3): Key {
                label: root.shift && !root.symbols ? k.to-uppercase() : k;
                value: k;
                activated(v) => { root.emit(v); }
            }
            Key {
                label: "⌫";
                special: true;
                horizontal-stretch: 1.5;
                activated => { root.backspace(); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Key {
                label: root.symbols ? "ABC" : "?123";
                special: true;
                horizontal-stretch: 1.5;
                activated => {
                    root.symbols = !root.symbols;
                    root.shift = false;
                }
            }
            Key {
                label: ",";
                activated(v) => { root.emit(v); }
            }
            Key {
                label: "space";
                value: " ";
                horizontal-stretch: 4.5;
                activated(v) => { root.emit(v); }
            }
            Key {
                label: ".";
                activated(v) => { root.emit(v); }
            }
            Key {
                label: root.enter-label;
                special: true;
                active: root.enter-enabled;
                enabled: root.enter-enabled;
                horizontal-stretch: 2.5;
                activated => { root.enter(); }
            }
        }
    }
}

// Single-line text display with a caret, fed from Rust.
export component EntryField inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> show-toggle;
    in property <bool> revealed;
    callback toggle();

    height: 60px;
    border-radius: 12px;
    background: Theme.surface;
    border-width: 2px;
    border-color: Theme.accent;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 8px;
        spacing: 2px;
        Text {
            text: root.text == "" ? root.placeholder : root.text;
            color: root.text == "" ? Theme.muted : Theme.text;
            font-size: 20px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0;
        }
        if root.text != "": Rectangle {
            width: 2px;
            height: 28px;
            y: 16px;
            background: Theme.accent;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.show-toggle: Rectangle {
            width: 84px;
            y: 6px;
            height: 44px;
            border-radius: 8px;
            background: toggle-ta.pressed ? Theme.surface-3 : Theme.surface-2;
            Text {
                text: root.revealed ? "Hide" : "Show";
                font-size: 16px;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            toggle-ta := TouchArea {
                clicked => { root.toggle(); }
            }
        }
    }
}

export component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text {
        text: root.label;
        width: 110px;
        font-size: 16px;
        color: Theme.muted;
    }
    Text {
        text: root.value;
        font-size: 16px;
        color: Theme.text;
        overflow: elide;
    }
}


// Row of mutually exclusive options.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    in property <bool> enabled: true;
    callback picked(int);
    height: 44px;
    border-radius: 10px;
    background: Theme.surface-2;
    // Disabled look through colours, not `opacity: c ? 1 : 0.4`: a select
    // between two float constants crashes the Xtensa LLVM backend.
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[i] in root.options: Rectangle {
            min-width: label.preferred-width + 24px;
            border-radius: 8px;
            background: i == root.selected ? (root.enabled ? Theme.accent : Theme.surface-3) : ta.pressed ? Theme.surface-3 : transparent;
            label := Text {
                text: option;
                font-size: 16px;
                color: !root.enabled ? Theme.muted : i == root.selected ? #ffffff : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                enabled: root.enabled;
                clicked => { root.picked(i); }
            }
        }
    }
}

// Heading inside a settings section.
export component SectionTitle inherits Text {
    font-size: 20px;
    font-weight: 600;
    color: Theme.text;
    vertical-alignment: center;
    horizontal-stretch: 1;
}

// A label on the left, the control (child) on the right.
export component SettingRow inherits HorizontalLayout {
    in property <string> label;
    spacing: 14px;
    Text {
        text: root.label;
        font-size: 17px;
        color: Theme.text;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    @children
}
