// Screensaver clock: a plain clock or a flip clock.
//
// Digits are images (ui/clock/*.png, made by scripts/gen_clock_digits.py),
// not text. They date from before the UI used SDF fonts, when a 200 px font
// would have cost megabytes of flash. Single-colour images are stored as
// alpha maps and can be scaled, which the flip animation relies on.

import { Icons } from "dashboard.slint";
import { ForecastDayView } from "types.slint";

// Screensaver colours: dark or light, set from Rust (its own theme setting).
export global SaverTheme {
    in-out property <bool> dark: true;
    out property <color> bg: root.dark ? #000000 : #eef0f4;
    out property <color> ink: root.dark ? #e9ecf2 : #151a23;
    out property <color> muted: root.dark ? #8b93a3 : #5b6474;
    // Flip-clock cards, the line across them and the colon.
    out property <color> card: root.dark ? #1b1f27 : #ffffff;
    out property <color> hinge: root.dark ? #07080b : #c9ced7;
    out property <color> colon: root.dark ? #9aa3b5 : #5b6474;
    // Forecast columns: today, the other days.
    out property <color> today: root.dark ? #161a22 : #ffffff;
    out property <color> day: root.dark ? #0e1116 : #e2e6ec;
    out property <color> rain: root.dark ? #60a5fa : #2563eb;
}

export global ClockGlyphs {
    // Weather condition (HA's state of a weather entity) -> icon.
    pure public function weather-icon(condition: string) -> string {
        if (condition == "sunny") {
            return "\u{F0599}";
        }
        if (condition == "clear-night") {
            return "\u{F0594}";
        }
        if (condition == "partlycloudy") {
            return "\u{F0595}";
        }
        if (condition == "cloudy") {
            return "\u{F0590}";
        }
        if (condition == "rainy") {
            return "\u{F0597}";
        }
        if (condition == "pouring") {
            return "\u{F0596}";
        }
        if (condition == "lightning") {
            return "\u{F0593}";
        }
        if (condition == "lightning-rainy") {
            return "\u{F067E}";
        }
        if (condition == "snowy") {
            return "\u{F0598}";
        }
        if (condition == "snowy-rainy") {
            return "\u{F067F}";
        }
        if (condition == "hail") {
            return "\u{F0592}";
        }
        if (condition == "fog") {
            return "\u{F0591}";
        }
        if (condition == "windy") {
            return "\u{F059D}";
        }
        if (condition == "windy-variant") {
            return "\u{F059E}";
        }
        return "\u{F05D6}";
    }

    out property <[image]> digits: [
        @image-url("clock/0.png"),
        @image-url("clock/1.png"),
        @image-url("clock/2.png"),
        @image-url("clock/3.png"),
        @image-url("clock/4.png"),
        @image-url("clock/5.png"),
        @image-url("clock/6.png"),
        @image-url("clock/7.png"),
        @image-url("clock/8.png"),
        @image-url("clock/9.png"),
    ];
    // Size of the digit images.
    out property <length> w: 148px;
    out property <length> h: 167px;
}

// One flip-clock card.
//
// When the digit changes, Rust sets `prev` (old digit) and `cur` (new digit)
// and drives `p` from 0 to 1 over the flip (Rust-driven: a Slint binding
// animation started noticeably late here):
//   0.0-0.5  the upper flap with the old digit folds down onto the hinge
//   0.5-1.0  the lower flap with the new digit unfolds from the hinge
component FlipDigit inherits Rectangle {
    in property <int> prev;
    in property <int> cur;
    in property <float> p: 1;
    property <length> half: self.height / 2;
    property <length> ix: (self.width - ClockGlyphs.w) / 2;
    property <length> iy: (self.height - ClockGlyphs.h) / 2;
    property <color> ink: SaverTheme.ink;
    property <color> card: SaverTheme.card;

    width: 164px;
    height: 220px;
    border-radius: 14px;
    background: root.card;

    // Upper half: always the new digit (uncovered as the flap falls).
    Rectangle {
        y: 0px;
        height: root.half;
        clip: true;
        Image {
            x: root.ix;
            y: root.iy;
            width: ClockGlyphs.w;
            height: ClockGlyphs.h;
            source: ClockGlyphs.digits[root.cur];
            colorize: root.ink;
        }
    }
    // Lower half: the old digit until the lower flap has landed.
    Rectangle {
        y: root.half;
        height: root.half;
        clip: true;
        Image {
            x: root.ix;
            y: root.iy - root.half;
            width: ClockGlyphs.w;
            height: ClockGlyphs.h;
            source: ClockGlyphs.digits[root.p >= 1 ? root.cur : root.prev];
            colorize: root.ink;
        }
    }
    // Falling upper flap: the old digit's top half, squashed towards the hinge.
    if root.p < 0.5: Rectangle {
        property <float> s: 1 - root.p * 2;
        y: root.half - root.half * self.s;
        height: root.half * self.s;
        clip: true;
        border-top-left-radius: 14px;
        border-top-right-radius: 14px;
        // Darkens as it turns away from the viewer.
        background: root.card.darker(0.6 * (1 - self.s));
        Image {
            x: root.ix;
            y: root.iy * parent.s;
            width: ClockGlyphs.w;
            height: ClockGlyphs.h * parent.s;
            image-fit: fill;
            source: ClockGlyphs.digits[root.prev];
            colorize: root.ink;
        }
    }
    // Unfolding lower flap: the new digit's bottom half, growing from the hinge.
    if root.p >= 0.5 && root.p < 1: Rectangle {
        property <float> s: (root.p - 0.5) * 2;
        y: root.half;
        height: root.half * self.s;
        clip: true;
        border-bottom-left-radius: 14px;
        border-bottom-right-radius: 14px;
        background: root.card.brighter(0.4 * (1 - self.s));
        Image {
            x: root.ix;
            y: (root.iy - root.half) * parent.s;
            width: ClockGlyphs.w;
            height: ClockGlyphs.h * parent.s;
            image-fit: fill;
            source: ClockGlyphs.digits[root.cur];
            colorize: root.ink;
        }
    }
    // Hinge.
    Rectangle {
        y: root.half - 1px;
        height: 2px;
        background: SaverTheme.hinge;
    }
}

component PlainDigit inherits Image {
    in property <int> value;
    width: ClockGlyphs.w;
    height: ClockGlyphs.h;
    source: ClockGlyphs.digits[root.value];
    colorize: SaverTheme.ink;
}

component Colon inherits VerticalLayout {
    alignment: center;
    spacing: 34px;
    width: 40px;
    for i in 2: Rectangle {
        width: 16px;
        height: 16px;
        x: 12px;
        border-radius: 8px;
        background: SaverTheme.colon;
    }
}

export component ScreenSaver inherits Rectangle {
    in property <bool> flip;
    // One property per card, not arrays: changing one element of an array
    // would make every card redraw.
    in property <int> d0;
    in property <int> d1;
    in property <int> d2;
    in property <int> d3;
    in property <int> prev0;
    in property <int> prev1;
    in property <int> prev2;
    in property <int> prev3;
    in property <float> p0: 1; // flip progress, 0-1; 1 = at rest
    in property <float> p1: 1;
    in property <float> p2: 1;
    in property <float> p3: 1;
    in property <string> date;
    in property <string> weather-condition;
    in property <string> weather-temperature;
    in property <string> indoor-temperature;

    background: SaverTheme.bg;

    VerticalLayout {
        alignment: center;
        spacing: 30px;
        if root.flip: HorizontalLayout {
            alignment: center;
            spacing: 12px;
            FlipDigit {
                prev: root.prev0;
                cur: root.d0;
                p: root.p0;
            }
            FlipDigit {
                prev: root.prev1;
                cur: root.d1;
                p: root.p1;
            }
            Colon { }
            FlipDigit {
                prev: root.prev2;
                cur: root.d2;
                p: root.p2;
            }
            FlipDigit {
                prev: root.prev3;
                cur: root.d3;
                p: root.p3;
            }
        }
        if !root.flip: HorizontalLayout {
            alignment: center;
            spacing: 4px;
            PlainDigit { value: root.d0; }
            PlainDigit { value: root.d1; }
            Colon { }
            PlainDigit { value: root.d2; }
            PlainDigit { value: root.d3; }
        }
        Text {
            text: root.date;
            font-size: 28px;
            color: SaverTheme.muted;
            horizontal-alignment: center;
        }
        if root.weather-temperature != "" || root.indoor-temperature != "": HorizontalLayout {
            alignment: center;
            spacing: 40px;
            if root.weather-temperature != "": HorizontalLayout {
                spacing: 10px;
                Text {
                    text: ClockGlyphs.weather-icon(root.weather-condition);
                    font-family: Icons.family;
                    font-size: 28px;
                    color: SaverTheme.muted;
                    vertical-alignment: center;
                }
                Text {
                    text: root.weather-temperature;
                    font-size: 28px;
                    color: SaverTheme.muted;
                    vertical-alignment: center;
                }
            }
            if root.indoor-temperature != "": HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "\u{F0F54}";
                    font-family: Icons.family;
                    font-size: 28px;
                    color: SaverTheme.muted;
                    vertical-alignment: center;
                }
                Text {
                    text: root.indoor-temperature;
                    font-size: 28px;
                    color: SaverTheme.muted;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// The 7-day forecast screensaver: now (weather, indoor temperature, time)
// on top, a column per day below. No font sizes above 48 px: Slint makes
// every glyph's distance field at the largest size used, which cost about
// 465 KB of flash and PSRAM with 56 and 76 px here.
export component ForecastView inherits Rectangle {
    in property <[ForecastDayView]> days;
    in property <string> time;
    in property <string> date;
    in property <string> weather-condition;
    in property <string> weather-temperature;
    in property <string> indoor-temperature;
    // Shown instead of the days when there are none.
    in property <string> title;
    in property <string> hint;

    property <color> ink: SaverTheme.ink;
    property <color> muted: SaverTheme.muted;

    background: SaverTheme.bg;

    VerticalLayout {
        padding: 32px;
        padding-top: 26px;
        spacing: 22px;
        HorizontalLayout {
            spacing: 18px;
            if root.weather-temperature != "": Text {
                text: ClockGlyphs.weather-icon(root.weather-condition);
                font-family: Icons.family;
                font-size: 48px;
                color: root.ink;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                if root.weather-temperature != "": Text {
                    text: root.weather-temperature;
                    font-size: 48px;
                    font-weight: 600;
                    color: root.ink;
                }
                if root.indoor-temperature != "": HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "\u{F0F54}";
                        font-family: Icons.family;
                        font-size: 22px;
                        color: root.muted;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.indoor-temperature;
                        font-size: 22px;
                        color: root.muted;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.time;
                    font-size: 48px;
                    font-weight: 600;
                    color: root.ink;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.date;
                    font-size: 20px;
                    color: root.muted;
                    horizontal-alignment: right;
                }
            }
        }
        if root.days.length > 0: HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;
            for day[i] in root.days: Rectangle {
                horizontal-stretch: 1;
                border-radius: 16px;
                background: i == 0 ? SaverTheme.today : SaverTheme.day;
                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 14px;
                    spacing: 6px;
                    Text {
                        text: day.name;
                        font-size: 20px;
                        font-weight: 600;
                        color: i == 0 ? root.ink : root.muted;
                        horizontal-alignment: center;
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: ClockGlyphs.weather-icon(day.condition);
                        font-family: Icons.family;
                        font-size: 48px;
                        color: root.ink;
                        horizontal-alignment: center;
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text {
                        text: day.high;
                        font-size: 30px;
                        font-weight: 600;
                        color: root.ink;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: day.low;
                        font-size: 22px;
                        color: root.muted;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 3px;
                        height: 24px;
                        if day.precipitation != "": Text {
                            text: "\u{F058C}";
                            font-family: Icons.family;
                            font-size: 16px;
                            color: SaverTheme.rain;
                            vertical-alignment: center;
                        }
                        if day.precipitation != "": Text {
                            text: day.precipitation;
                            font-size: 16px;
                            color: SaverTheme.rain;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        if root.days.length == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 12px;
            padding-left: 60px;
            padding-right: 60px;
            Text {
                text: root.title;
                font-size: 28px;
                font-weight: 600;
                color: root.ink;
                horizontal-alignment: center;
            }
            Text {
                text: root.hint;
                font-size: 18px;
                color: root.muted;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }
}
