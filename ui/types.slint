// Data types shared between Rust and the UI.

export struct NetworkItem {
    ssid: string,
    bars: int, // 1-4
    secure: bool,
}

export struct InstanceItem {
    name: string,
    url: string,
}

export struct PageTab {
    title: string,
    icon: string, // glyph from the Material Design Icons font, "" for none
}

// One tile on the dashboard grid plus its current state (docs/protocol.md).
export struct TileData {
    id: string,
    kind: string, // light | gate | garage | valve | climate | toggle
    domain: string, // entity domain, e.g. "automation"
    label: string,
    x: int,
    y: int,
    w: int,
    h: int,
    available: bool,
    on: bool,
    status: string,
    detail: string,
    moving: bool,
    mode: string, // climate hvac mode
    value: string, // large text on tall climate tiles, e.g. "23.5°"
    icon: string, // glyph chosen in the editor, "" for the kind's own icon
    // Light: sliders on the tile, their values, and the light's own colour.
    ctl-brightness: bool,
    ctl-hue: bool,
    ctl-kelvin: bool,
    brightness: int, // 0-100
    hue: int, // 0-359
    kelvin: int,
    kelvin-min: int,
    kelvin-max: int,
    has-color: bool,
    color: color,
}

// One day of the screensaver's forecast; text already formatted.
export struct ForecastDayView {
    name: string, // "Today", "Mon", ...
    condition: string, // HA condition, picks the icon
    high: string, // "18°"
    low: string, // "11°" or ""
    precipitation: string, // "80%" or ""
}

export struct ModeItem {
    id: string,
    label: string,
}

// A button in the action sheet (blinds, locks, alarm, media). The icon is
// chosen in Slint from `id` (Icons.for-action), as only glyphs written in the
// .slint files are embedded.
export struct ActionButton {
    id: string,
    label: string,
    primary: bool,
}
